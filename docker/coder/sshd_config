# What this box will and will not accept.
#
# Written out rather than patched into the distribution's file with sed, because
# a security posture assembled by twelve in-place edits is one nobody can read.

Port 22
AddressFamily any

# Kept on a volume, so the fingerprint Orknux recorded on first use is still the
# fingerprint tomorrow. See the note in the Dockerfile: a shell whose host key
# changes on every restart teaches whoever owns it to clear the check.
HostKey /etc/ssh/keys/ssh_host_ed25519_key
HostKey /etc/ssh/keys/ssh_host_rsa_key

# Keys only.
#
# Orknux authenticates a shell with a private key and has nowhere to put a
# password, so a password here is a door the product cannot use. The other three
# are off because each is a way in that does not need the key: an empty password,
# a keyboard-interactive prompt that some PAM stacks answer for you, and PAM
# itself, which on a stock Debian will happily do password auth behind sshd's
# back after this file has said no to it.
PubkeyAuthentication yes
PasswordAuthentication no
PermitEmptyPasswords no
KbdInteractiveAuthentication no
UsePAM no

# Not root. A task that runs as root leaves files nobody else can remove and
# turns an ordinary mistake into an unrecoverable one.
PermitRootLogin no
AllowUsers coder

AuthorizedKeysFile .ssh/authorized_keys

# What a task actually needs: to run a command, and to copy files in and out.
# A terminal is allowed because a person will sometimes want one to see what the
# agent saw. Forwarding is not: this box is a place to build software, not a way
# into whatever network it happens to sit on.
Subsystem sftp /usr/lib/openssh/sftp-server
AllowTcpForwarding no
AllowStreamLocalForwarding no
GatewayPorts no
X11Forwarding no
PermitTunnel no

# A build can be long and silent - a test suite says nothing for ten minutes -
# so the daemon asks rather than assumes, and only gives up after three
# unanswered probes.
ClientAliveInterval 60
ClientAliveCountMax 3
TCPKeepAlive yes

# Enough to answer "did it connect, and as whom", which is the first question
# asked when a shell does not work.
LogLevel VERBOSE
PrintMotd no
AcceptEnv LANG LC_*
