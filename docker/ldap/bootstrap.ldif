dn: ou=people,dc=orknux,dc=io
objectClass: organizationalUnit
ou: people

dn: ou=groups,dc=orknux,dc=io
objectClass: organizationalUnit
ou: groups

dn: uid=alice,ou=people,dc=orknux,dc=io
objectClass: inetOrgPerson
uid: alice
cn: Alice Example
sn: Example
mail: alice@orknux.io
userPassword: password

dn: uid=bob,ou=people,dc=orknux,dc=io
objectClass: inetOrgPerson
uid: bob
cn: Bob Example
sn: Example
mail: bob@orknux.io
userPassword: password

dn: cn=admins,ou=groups,dc=orknux,dc=io
objectClass: groupOfNames
cn: admins
member: uid=alice,ou=people,dc=orknux,dc=io

dn: cn=users,ou=groups,dc=orknux,dc=io
objectClass: groupOfNames
cn: users
member: uid=alice,ou=people,dc=orknux,dc=io
member: uid=bob,ou=people,dc=orknux,dc=io

# A group named after a workspace grants access to it: cn=backend -> ROLE_BACKEND -> workspace "backend".
dn: cn=backend,ou=groups,dc=orknux,dc=io
objectClass: groupOfNames
cn: backend
member: uid=bob,ou=people,dc=orknux,dc=io
